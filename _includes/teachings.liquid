<div class="col">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      {% if project.img_light or project.img_dark %}
        {% if project.img_light %}
          {%
            include figure.liquid
            loading="eager"
            path=project.img_light
            sizes="250px"
            alt="project thumbnail"
            class="card-img-top theme-img-light"
          %}
        {% endif %}
        {% if project.img_dark %}
          {%
            include figure.liquid
            loading="eager"
            path=project.img_dark
            sizes="250px"
            alt="project thumbnail"
            class="card-img-top theme-img-dark"
          %}
        {% endif %}
      {% elsif project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes="250px"
          alt="project thumbnail"
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
      </div>
    </div>
  </a>
</div>
